Package: trialdesign
Type: Package
Title: Generate Randomization Lists and Sample Size Calculations for Clinical Trials
Version: 0.1.0
Authors@R: c(
    person("USMR", "CHU de Bordeaux", role = c("aut", "cre"), email = "biostatisticien.usmr@chu-bordeaux.fr"),
